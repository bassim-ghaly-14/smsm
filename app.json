{
  "expo": {
    "name": "SMSM",
    "slug": "smsm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/smsm-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smsm.app"
    },
    "android": {
      "package": "com.smsm.app",
      "adaptiveIcon": {
        "backgroundColor": "#171521",
        "foregroundImage": "./assets/images/smsm-adaptive-foreground.png",
        "backgroundImage": "./assets/images/smsm-adaptive-background.png",
        "monochromeImage": "./assets/images/smsm-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
